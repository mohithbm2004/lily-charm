PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/lilycharm
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Store URLs
CLIENT_URL=http://localhost:5173
ADMIN_CLIENT_URL=http://localhost:5174

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ZeptoMail Multi-Channel SMTP Configuration
ZEPTO_OTP_HOST=smtp.zeptomail.in
ZEPTO_OTP_PORT=587
ZEPTO_OTP_USER=emailapikey
ZEPTO_OTP_PASSWORD=

ZEPTO_ORDER_HOST=smtp.zeptomail.in
ZEPTO_ORDER_PORT=587
ZEPTO_ORDER_USER=emailapikey
ZEPTO_ORDER_PASSWORD=

ZEPTO_SUPPORT_HOST=smtp.zeptomail.in
ZEPTO_SUPPORT_PORT=587
ZEPTO_SUPPORT_USER=emailapikey
ZEPTO_SUPPORT_PASSWORD=

ZEPTO_CONTACT_HOST=smtp.zeptomail.in
ZEPTO_CONTACT_PORT=587
ZEPTO_CONTACT_USER=emailapikey
ZEPTO_CONTACT_PASSWORD=

# ZeptoMail Webhook Verification Secret
ZEPTOMAIL_WEBHOOK_SECRET=

# Generic ZeptoMail Legacy Fallback
ZEPTOMAIL_HOST=smtp.zeptomail.in
ZEPTOMAIL_PORT=587
ZEPTOMAIL_USER=emailapikey
ZEPTOMAIL_PASSWORD=

# ZeptoMail Purpose-Based Sender Addresses
EMAIL_FROM="Lily Charm" <no-reply@lilycharm.in>
EMAIL_FROM_NOREPLY="Lily Charm" <no-reply@lilycharm.in>
EMAIL_FROM_ORDERS="Lily Charm Orders" <orders@lilycharm.in>
EMAIL_FROM_SUPPORT="Lily Charm Support" <support@lilycharm.in>
EMAIL_FROM_CONTACT="Lily Charm Studio" <contact@lilycharm.in>

# Studio Admin & Inquiry Notification Receiver
ADMIN_EMAIL=keerthanabm@lilycharm.in
CONTACT_RECEIVER_EMAIL=keerthanabm@lilycharm.in

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
