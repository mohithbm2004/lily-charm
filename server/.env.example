PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/bloom-atelier
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Store URLs
CLIENT_URL=http://localhost:5173
ADMIN_CLIENT_URL=http://localhost:5174

# Email Provider 1: Brevo SMTP (Auth, OTPs, Verification, Welcome)
BREVO_HOST=smtp-relay.brevo.com
BREVO_PORT=587
BREVO_USER=your_brevo_login_email@domain.com
BREVO_PASS=your_brevo_smtp_key

# Email Provider 2: Amazon SES SMTP (Orders, Invoices, Shipping, Deliveries, Refunds)
AWS_SES_HOST=email-smtp.us-east-1.amazonaws.com
AWS_SES_PORT=587
AWS_SES_USER=your_aws_ses_smtp_username
AWS_SES_PASS=your_aws_ses_smtp_password

# Global Sender Address
EMAIL_FROM="Lily Charm Studio" <no-reply@lilycharm.com>
